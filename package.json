{
  "name": "lynn",
  "version": "0.87.5",
  "type": "module",
  "description": "Lynn - a personal AI agent with memory and soul",
  "license": "Apache-2.0",
  "author": {
    "name": "liliMozi"
  },
  "keywords": [
    "ai-agent",
    "electron",
    "memory",
    "multi-platform",
    "telegram",
    "personal-assistant"
  ],
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build:renderer && node --import tsx scripts/launch.ts electron",
    "start:dev": "node --import tsx scripts/launch.ts electron-dev",
    "start:vite": "node --import tsx scripts/launch.ts electron-vite",
    "dev:renderer": "vite --config vite.config.ts",
    "build:cli": "npm --prefix cli run build",
    "build:renderer": "vite build --config vite.config.ts",
    "test:renderer-lazy-chunks": "node scripts/verify-renderer-lazy-chunks.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json",
    "test:architecture": "node scripts/check-frontend-import-cycles.mjs",
    "cli": "node --import tsx scripts/launch.ts cli",
    "server": "node --import tsx scripts/launch.ts server",
    "build:main": "vite build --config vite.config.main.ts",
    "pack:cli": "node scripts/pack-cli.mjs",
    "pack": "export SKIP_NOTARIZE=true && npm run build:cli && npm run build:server && npm run build:main && npm run build:renderer && electron-builder --dir && npm run test:packaged-server && npm run test:packaged-cli",
    "install:local": "npm run pack && rm -rf /Applications/Lynn.app && cp -R dist/mac-arm64/Lynn.app /Applications/ && node scripts/sign-local.cjs",
    "install:app": "rm -rf /Applications/Lynn.app && cp -R dist/mac-arm64/Lynn.app /Applications/ && codesign --verify --deep --strict /Applications/Lynn.app && echo \"Installed: /Applications/Lynn.app\"",
    "ensure:electron-macos-signature": "node scripts/ensure-electron-macos-signature.mjs",
    "dist": "export APPLE_NOTARY_PROFILE=${APPLE_NOTARY_PROFILE:-lynn-notary} && npm run release:full-gate && electron-builder --mac dmg",
    "dist:local": "export SKIP_NOTARIZE=true && npm run build:cli && npm run build:server && npm run build:main && npm run build:renderer && electron-builder --mac dmg --publish never && npm run test:packaged-server && npm run test:packaged-cli",
    "dist:win": "npm run release:full-gate && npm run prepare:llamacpp:win && npm run build:server:win && electron-builder --win nsis --x64 && npm run test:windows-llamacpp-installer",
    "test": "vitest run",
    "test:brain-v2": "npm --prefix brain-v2-mirror test",
    "test:brain-v2:critical": "npm --prefix brain-v2-mirror test -- __tests__/router.test.js __tests__/search-context.test.js __tests__/web_search.test.js __tests__/evidence-quality.test.js __tests__/tool-exec.test.js __tests__/stream-bridge.test.js __tests__/tool-storm.test.js",
    "test:cli": "npm run build:cli && node scripts/cli-smoke.mjs",
    "test:windows-llamacpp-installer": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-llamacpp-installer.ps1",
    "test:cli-pack": "npm run pack:cli -- --out /tmp/lynn-cli-pack-smoke",
    "test:cli-install": "npm run build:cli && node scripts/cli-install-smoke.mjs",
    "test:cli-install:remote": "node scripts/cli-install-smoke.mjs --remote",
    "test:cli-brain-registration": "npm run build:cli && node scripts/cli-brain-registration-gate.mjs",
    "test:cli-pressure": "npm run build:cli && node scripts/cli-p-stress.mjs",
    "test:cli-real": "npm run build:cli && node scripts/cli-real-model-soak.mjs",
    "test:cli-toolchain": "npm run build:cli && node scripts/cli-toolchain-stress.mjs",
    "bench:cli-efficiency": "npm run build:cli && node scripts/cli-efficiency-gate.mjs",
    "bench:cli-routes": "npm run build:cli && node scripts/cli-route-latency-smoke.mjs",
    "test:cli-cache-usage": "npm run build:cli && node scripts/cli-cache-usage-smoke.mjs",
    "test:cli-file-size": "node scripts/check-cli-file-size.mjs",
    "test:cli-nightly": "node scripts/v0804-cli-nightly.mjs --mode quick",
    "test:cli-v0806-nightly": "node scripts/v0806-cli-nightly.mjs",
    "test:cli-pty": "npm run build:cli && node scripts/cli-pty-smoke.mjs",
    "test:cli-terminal-app": "npm run build:cli && node scripts/cli-terminal-app-smoke.mjs",
    "test:cli-terminal-ime": "npm run build:cli && node scripts/cli-terminal-ime-smoke.mjs",
    "test:cli-terminal-soak": "npm run build:cli && node scripts/cli-terminal-app-smoke.mjs",
    "test:voice-router": "npm test -- --run tests/voice-asr-providers.test.js tests/voice-ws-route.test.js",
    "test:voice-cli": "npm run build:cli && npm --prefix cli run test:voice && node scripts/cli-voice-smoke.mjs && node scripts/cli-voice-repl-pty-smoke.mjs",
    "test:voice-gui": "npm test -- --run desktop/src/react/settings/tabs/VoiceTab.test.tsx desktop/src/react/components/chat/TtsControlButton.test.tsx tests/tts-bridge-cosyvoice-stream.test.js",
    "test:gui-feedback": "npm test -- --run desktop/src/react/__tests__/services/ws-message-handler.test.ts",
    "test:packaged-cli": "node scripts/packaged-cli-runtime-smoke.mjs",
    "test:packaged-server": "node scripts/packaged-server-smoke.mjs",
    "test:packaged-settings": "node scripts/packaged-settings-provider-smoke.mjs",
    "test:packaged-main-ui": "node scripts/packaged-main-ui-smoke.mjs",
    "test:packaged-live-vision": "LYNN_INSTALLED_GATE_REQUIRE_VISION=1 node scripts/gate-installed-app.mjs --only-live-vision",
    "test:cli-fleet": "npm --prefix cli run test:fleet && npm test -- --run server/fleet/__tests__/fleet-server.test.ts desktop/src/react/components/fleet/__tests__ --reporter=dot && node scripts/cli-longrun-smoke.mjs",
    "voice:smoke": "node --import tsx scripts/voice-runtime-smoke.ts",
    "test:agent-regression": "node --import tsx scripts/run-agent-regression.mjs --level release",
    "test:agent-regression:smoke": "node --import tsx scripts/run-agent-regression.mjs --level smoke",
    "test:agent-regression:nightly": "node --import tsx scripts/run-agent-regression.mjs --level nightly",
    "test:agent-regression:gates": "node --import tsx scripts/run-agent-regression.mjs --case-bank agent-regression-kit/cases/lynn-gates-v1.json --level release",
    "test:agent-regression:gates:smoke": "node --import tsx scripts/run-agent-regression.mjs --case-bank agent-regression-kit/cases/lynn-gates-v1.json --level smoke",
    "test:agent-regression:gates:nightly": "node --import tsx scripts/run-agent-regression.mjs --case-bank agent-regression-kit/cases/lynn-gates-v1.json --level nightly",
    "test:release": "node scripts/run-release-regression.mjs --mode all --level release",
    "test:release:root": "vitest run --maxWorkers=6",
    "test:release:static": "node scripts/run-release-regression.mjs --mode static --level release",
    "test:release:live": "node scripts/run-release-regression.mjs --mode live --level release",
    "test:release:smoke": "node scripts/run-release-regression.mjs --mode all --level smoke",
    "test:release:nightly": "node scripts/run-isolated-release-regression.mjs --mode all --level nightly",
    "test:release:ui": "node --import tsx scripts/run-electron-ui-smoke.ts",
    "test:automation-visual": "npm run build:renderer && node --import tsx scripts/run-electron-ui-smoke.ts --automation-visual-only",
    "gate:clean-data": "node scripts/cleanup-gate-data.mjs",
    "gate:startup": "node scripts/gate-startup-recovery.mjs",
    "gate:cli-task": "npm run build:cli && node scripts/gate-cli-task.mjs",
    "gate:cli-50": "npm run build:cli && node scripts/cli-50-dialogue-runner.mjs",
    "gate:cli-100": "npm run build:cli && node scripts/cli-50-dialogue-runner.mjs --limit 100",
    "gate:cli-200": "npm run build:cli && node scripts/cli-50-dialogue-runner.mjs --limit 100 --repeat 2",
    "release:gate": "node scripts/release-gate.mjs",
    "prerelease:preflight": "npm run ensure:electron-macos-signature",
    "release:preflight": "npm run test:release:root && npm run test:architecture && npm run build:cli && npm run test:agent-regression && npm run test:brain-v2 && npm run release:verify-brain-prod && npm run release:verify-codex-harness-prod && npm run typecheck && npm run typecheck:runtime && npm run test:cli-file-size && npm run test:cli-cache-usage && npm run test:cli && npm run test:cli-pack && npm run test:cli-install && npm run test:cli-brain-registration && npm --prefix cli run stress:cli && npm run test:cli-pty && npm run test:cli-terminal-soak && npm run test:cli-fleet && npm run test:voice-router && npm run test:voice-cli && npm run test:voice-gui && npm run test:voice-step && npm run test:gui-feedback && npm run build:server && npm run build:main && npm run build:renderer && npm run test:renderer-lazy-chunks && npm run test:release:static && npm run test:release:ui && npm run gate:startup && npm run gate:cli-task && npm run gate:gui-task && npm run gate:agent-matrix",
    "build:server": "node scripts/build-server.mjs",
    "build:server:win": "node scripts/build-server.mjs win32 x64",
    "prepare:llamacpp:win": "node scripts/prepare-windows-llamacpp.mjs",
    "release:manifest": "LYNN_RELEASE_INCLUDE_WINDOWS=1 node --import tsx scripts/generate-update-manifest.ts",
    "release:verify-mac": "node scripts/verify-macos-release-artifacts.mjs",
    "release:verify-remotes": "node scripts/verify-release-remotes.mjs",
    "release:verify-brain-prod": "bash scripts/mirror-prod-diff.sh",
    "release:verify-codex-harness-prod": "node --import tsx scripts/verify-codex-harness-prod.ts",
    "release:finalize-mac": "APPLE_NOTARY_PROFILE=${APPLE_NOTARY_PROFILE:-lynn-notary} scripts/finalize-macos-dmg.sh dist/Lynn-${npm_package_version}-macOS-arm64.dmg dist/Lynn-${npm_package_version}-macOS-x64.dmg && npm run release:verify-mac",
    "lint": "eslint desktop/src/ server/",
    "test:watch": "vitest",
    "release:cli-efficiency": "npm run build:cli && node scripts/release-cli-efficiency.mjs",
    "gate:gui-task": "npm run build:server && npm run build:main && npm run build:renderer && node scripts/gate-gui-task.mjs",
    "gate:gui-50": "node scripts/gate-gui-50-dialogues.mjs",
    "gate:gui-100": "node scripts/gate-gui-50-dialogues.mjs --limit 100",
    "gate:agent-matrix": "node --import tsx scripts/gate-agent-task-matrix.mjs --live-all",
    "test:voice-step": "node --import tsx scripts/gate-voice-step-realtime.mjs",
    "release:installed-gate": "node scripts/gate-installed-app.mjs",
    "release:full-gate": "npm run gate:clean-data && npm run release:preflight && npm run release:cli-efficiency && npm run gate:cli-200 && npm run gate:gui-100",
    "release:overnight": "npm run release:full-gate && npm run test:release:nightly",
    "gate:dependency-audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.1",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@sinclair/typebox": "^0.34.0",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "duck-duck-scrape": "^2.2.7",
    "edge-tts": "^1.0.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "hono": "^4.13.14",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.39",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.3.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2",
    "node-telegram-bot-api": "^0.67.0",
    "pptxgenjs": "^4.0.1",
    "proper-lockfile": "4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "^7.30.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.11",
    "jszip": "^3.10.1"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "qs": "6.14.1",
    "tough-cookie": "^4.1.3",
    "protobufjs": "7.6.4",
    "image-size": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/nft": "^1.5.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ink": "^6.4.0",
    "jsdom": "^29.1.0",
    "msw": "^2.13.4",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.lynn.app",
    "productName": "Lynn",
    "asar": true,
    "asarUnpack": [
      "desktop/native-modules/aec/*.node"
    ],
    "compression": "maximum",
    "afterPack": "./scripts/fix-modules.cjs",
    "extraMetadata": {
      "main": "desktop/main.bundle.cjs"
    },
    "files": [
      "desktop/main.bundle.cjs",
      "desktop/preload.cjs",
      "desktop/native-modules/aec/index.js",
      "desktop/native-modules/aec/*.node",
      "desktop/dist-renderer/**",
      "desktop/src/**/*.html",
      "desktop/src/**/*.json",
      "desktop/src/**/*.svg",
      "desktop/src/icon.icns",
      "desktop/src/icon.png",
      "desktop/src/assets/tray-template*.png",
      "desktop/src/assets/tray-dev-template*.png",
      "desktop/src/assets/*.ico",
      "package.json",
      "!**/node_modules/**",
      "node_modules/ws/**"
    ],
    "extraResources": [
      {
        "from": "cli/bin/lynn.mjs",
        "to": "cli/lynn.mjs"
      },
      {
        "from": "dist-server/${os}-${arch}/",
        "to": "server/"
      }
    ],
    "afterSign": "./scripts/notarize.cjs",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "desktop/src/icon.icns",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "timestamp": null,
      "sign": "./scripts/mac-sign-no-timestamp.cjs",
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "signIgnore": [
        "^.*\\.(png|jpg|jpeg|gif|webp|svg|ico|icns|woff|woff2|ttf|otf|html|css|json|md|txt|yaml|yml|wasm)$",
        "^.*\\.pak$",
        "^.*\\.bin$",
        "^.*\\.dat$",
        "^.*MainMenu\\.nib(/.*)?$"
      ]
    },
    "dmg": {
      "title": "Lynn",
      "contents": [
        {
          "x": 180,
          "y": 220
        },
        {
          "x": 420,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://download.merkyorlynn.com/downloads/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/src/icon.png",
      "artifactName": "${productName}-${version}-Windows-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "vendor/git-portable",
          "to": "git"
        },
        {
          "from": "vendor/llama.cpp/win-x64",
          "to": "llamacpp/bin"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "msw": {
    "workerDirectory": [
      "desktop/src/public"
    ]
  }
}
